const REC = (p) => {
  if(p.priority==='High'&&p.recommendedFY==='FY27') return {label:'Pursue Immediately',tone:'strong'};
  if(p.recommendedFY==='FY27') return {label:'Pursue in FY27',tone:'strong'};
  if(p.recommendedFY==='FY28') return {label:'Pursue in FY28',tone:'mid'};
  return {label:'Monitor for FY29',tone:'soft'};
};
export function buildInsights(p){
  const c = CAT[p.category]||CAT["Emerging & Strategic Innovation"];
  const rec = REC(p);
  return {
    joint:c.joint, value:c.value, impl:c.impl, rec,
    swot:{
      s:c.strengths, w:c.weaknesses, o:c.opps, t:c.threats
    },
    rationale:`${p.whyPartner}. Benchmark validation: ${p.benchmarkAdoption||0} of 25 comparator firms already partner. ${p.name} sits in the ${p.priority.toLowerCase()}-priority band with a recommended ${p.recommendedFY} pursuit window.`,
    crossSell:`Introduce ${p.name} into existing KaarTech SAP accounts in ${p.geo.includes('Middle East')||p.geo.includes('MENA')?'the Gulf region':'core markets'} where ${p.subCategory.toLowerCase()} capability gaps exist; bundle with AMS renewals and S/4HANA transformation roadmaps.`,
    managed:`Wrap ${p.name} into KaarTech managed-services catalog: operations, monitoring and continuous optimization delivered from the global delivery centers — converting a license relationship into recurring annuity revenue.`,
    coInnov:`Joint accelerator combining ${p.name} (${p.subCategory.toLowerCase()}) with KaarTech's SAP delivery IP — a named, co-branded offering for ${(p.geo.includes('MENA')||p.geo.includes('Middle East'))?'Gulf':'global'} enterprise clients.`
  };
}
